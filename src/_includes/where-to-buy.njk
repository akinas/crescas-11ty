<div class="buy-section-container reveal">
  {% if lang == 'he' %}
    <h2>איפה להשיג?</h2>
    
    <div class="buy-grid">
      <!-- Israel Purchase Card -->
      <div class="buy-card">
        <div class="buy-card-header">
          <h3>בישראל (משלוח מקומי)</h3>
          <p>זמין לרכישה ישירה בישראל דרך אתר BookPod במהדורה מודפסת ואיכותית.</p>
        </div>
        <a class="btn btn-rubric" href="{{ site.buyLinks.israel }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
          </svg>
          רכישה ב-BookPod ישראל
        </a>
      </div>

      <!-- Worldwide Amazon Card -->
      <div class="buy-card">
        <div class="buy-card-header">
          <h3>בארץ ובחו״ל (Amazon)</h3>
          <p>משלוח לכל רחבי העולם דרך זירות המסחר הבינלאומיות של אמזון.</p>
          <ul class="marketplaces" aria-label="זירות מסחר בינלאומיות של אמזון">
            {% for mp in site.buyLinks.marketplaces %}
              <li><a href="{{ mp.url }}" target="_blank" rel="noopener noreferrer" title="{{ mp.name }}">{{ mp.code }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <a class="btn btn-primary" href="{{ site.buyLinks.amazon }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
          </svg>
          לרכישה ב-Amazon
        </a>
      </div>
    </div>
  {% else %}
    <h2>Where to Buy?</h2>
    
    <div class="buy-grid">
      <!-- Israel Purchase Card -->
      <div class="buy-card">
        <div class="buy-card-header">
          <h3>In Israel (Local Delivery)</h3>
          <p>Available directly in Israel via BookPod in high quality paperback edition.</p>
        </div>
        <a class="btn btn-rubric" href="{{ site.buyLinks.israel }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
          </svg>
          Order on BookPod Israel
        </a>
      </div>

      <!-- Worldwide Amazon Card -->
      <div class="buy-card">
        <div class="buy-card-header">
          <h3>Worldwide (Amazon)</h3>
          <p>Worldwide shipping available through Amazon international marketplaces.</p>
          <ul class="marketplaces" aria-label="Amazon International Marketplaces">
            {% for mp in site.buyLinks.marketplaces %}
              <li><a href="{{ mp.url }}" target="_blank" rel="noopener noreferrer" title="{{ mp.name }}">{{ mp.code }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <a class="btn btn-primary" href="{{ site.buyLinks.amazon }}" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
          </svg>
          Order on Amazon.com
        </a>
      </div>
    </div>
  {% endif %}
</div>


